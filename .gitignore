# Ignora arquivos de cache do Node.js
node_modules/
npm-debug.log
.DS_Store
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignora arquivos de cache do Wwebjs
backend/.wwebjs_cache/
backend/.wwebjs_auth/

# Ignora arquivos de upload (se não devem ser versionados)
backend/uploads/

# Ignora resultados de testes (se aplicável)
__tests__/
# ou se for algo específico como jest-results.json
# jest-results.json

# Ignora logs
logs/
*.log
*-stdout.txt
*-stderr.txt

# Ignora builds ou dist
#build/
dist/
out/

# Sessões e temporários do WhatsApp / Puppeteer / Electron
backend/sessions/
temp_user_data/
*.backp

# Dados de conversas de contatos (privacidade)
backend/data/conversations/